    <!-- 칸반 카드 보드 이동만 업데이트 (배치 처리용) -->
    <update id="updateTaskBoard" parameterType="com.demo.proworks.task.vo.TaskVo">
    	<!-- 업무(Task)의 보드 위치만 갱신한다. (칸반 카드 이동용) -->
    	
        UPDATE TASK    /* QueryID : com.demo.proworks.task.updateTaskBoard */      
      	  SET  
                BOARD_ID = #{boardId}
        WHERE   
                TASK_ID = #{taskId}        
    </update>
	
    <!-- 칸반 카드 삭제 -->
    <delete id="deleteTask" parameterType="com.demo.proworks.task.vo.TaskVo">
    	<!-- 업무(Task) 정보를 삭제한다. -->
    	
        DELETE FROM TASK   /* QueryID : com.demo.proworks.task.deleteTask */ 
        WHERE   
                TASK_ID = #{taskId}                
    </delete>
	
