    <!-- 칸반 보드 카드 목록 조회 (TaskVo 필드와 정확히 일치) -->
    <select id="selectListTask" parameterType="com.demo.proworks.task.vo.TaskVo" resultType="com.demo.proworks.task.vo.TaskVo">
<!-- 업무(Task) 정보 목록을 조회한다. -->
           SELECT    /* QueryID : com.demo.proworks.task.selectListTask */
               TASK_ID as taskId, 
               BOARD_ID as boardId, 
               PROJECT_USER_ID as projectUserId, 
               PROJECT_REPO_ID as projectRepoId, 
               TASK_TITLE as taskTitle, 
               PRIORITY as priority, 
               START_DATE as startDate, 
               END_DATE as endDate, 
               TAGS as tags		       
           FROM (
               SELECT  S.*, CEIL( (@ROWNUM:=@ROWNUM+1) / #{pageSize} ) AS PAGE
               FROM (				
                   SELECT 
                       *  		                  
                   FROM TASK
                   WHERE  1=1    		
                   <if test="projectUserId != null and projectUserId != ''"> AND PROJECT_USER_ID = #{projectUserId} </if>
                   <if test="boardId != null and boardId != ''"> AND BOARD_ID = #{boardId} </if>
               ) S, (SELECT @ROWNUM := 0) TMP
           ) A
            WHERE PAGE = #{pageIndex}
</select>
    
    <!-- 프로젝트의 모든 칸반 카드 조회 (TaskVo 필드와 정확히 일치) -->
    <select id="selectKanbanCardsByProject" parameterType="com.demo.proworks.task.vo.TaskVo" resultType="com.demo.proworks.task.vo.TaskVo">
        <!-- 프로젝트별 칸반 카드 전체 조회 -->
        SELECT   /* QueryID : com.demo.proworks.task.selectKanbanCardsByProject */
            TASK_ID as taskId, 
            BOARD_ID as boardId, 
            PROJECT_USER_ID as projectUserId, 
            PROJECT_REPO_ID as projectRepoId, 
            TASK_TITLE as taskTitle, 
            PRIORITY as priority, 
            START_DATE as startDate, 
            END_DATE as endDate, 
            TAGS as tags
        FROM TASK 
        WHERE 1=1
        <if test="projectUserId != null and projectUserId != ''"> AND PROJECT_USER_ID = #{projectUserId} </if>
        <if test="boardId != null and boardId != ''"> AND BOARD_ID = #{boardId} </if>
        ORDER BY CREATED_AT DESC
    </select>
    
