	<update id="updateTask" parameterType="com.demo.proworks.task.vo.TaskVo">
		<!-- 업무(Task) 정보를 갱신한다. -->

		UPDATE TASK /* QueryID : com.demo.proworks.task.updateTask */
		SET
		BOARD_ID = #{boardId}
		, PROJECT_USER_ID = #{projectUserId}
		<if test="projectRepoId!= null and projectRepoId!=0"> , PROJECT_REPO_ID = #{projectRepoId} </if>
		, TASK_TITLE = #{taskTitle}
		, PRIORITY = #{priority}
		, START_DATE = #{startDate}
		, END_DATE = #{endDate}
		, TAGS = #{tags}
		WHERE TASK_ID = #{taskId}
	</update>

	<select id="selectTask" parameterType="com.demo.proworks.task.vo.TaskVo" resultType="com.demo.proworks.task.vo.TaskVo">
		<!-- 업무(Task) 정보를 상세 조회하며 사용자 이름도 함께 조회 -->
		SELECT /* QueryID : com.demo.proworks.task.selectTask */
		t.TASK_ID AS taskId,
		t.BOARD_ID AS boardId,
		t.PROJECT_USER_ID AS projectUserId,
		t.PROJECT_REPO_ID AS projectRepoId,
		t.TASK_TITLE AS taskTitle,
		t.PRIORITY AS priority,
		t.START_DATE AS startDate,
		t.END_DATE AS endDate,
		t.TAGS AS tags,
		u.USER_NAME AS userName
		FROM task t
		JOIN project_user p ON t.project_user_id = p.project_user_id
		JOIN user u ON u.user_id =
		p.user_id
		WHERE t.TASK_ID = #{taskId}
	</select>
    
    <!-- 칸반 카드 생성 (PROJECT_REPO_ID null 허용) -->
    <insert id="insertTask" parameterType="com.demo.proworks.task.vo.TaskVo" useGeneratedKeys="true" keyProperty="taskId">
    	<!-- 업무(Task) 정보를 등록한다. (AUTO_INCREMENT 사용) -->	
    		
        INSERT INTO TASK   /* QueryID : com.demo.proworks.task.insertTask */
        (
            BOARD_ID,
            PROJECT_USER_ID,
            <if test="projectRepoId != null and projectRepoId != ''">PROJECT_REPO_ID,</if>
            TASK_TITLE,
            PRIORITY
            <if test="startDate != null and startDate != ''">, START_DATE</if>
            <if test="endDate != null and endDate != ''">, END_DATE</if>
            <if test="tags != null and tags != ''">, TAGS</if>
        )
        VALUES  
        (
            #{boardId},
            #{projectUserId},
            <if test="projectRepoId != null and projectRepoId != ''">#{projectRepoId},</if>
            #{taskTitle},
            #{priority}
            <if test="startDate != null and startDate != ''">, #{startDate}</if>
            <if test="endDate != null and endDate != ''">, #{endDate}</if>
            <if test="tags != null and tags != ''">, #{tags}</if>
        )          
    </insert>	
	
