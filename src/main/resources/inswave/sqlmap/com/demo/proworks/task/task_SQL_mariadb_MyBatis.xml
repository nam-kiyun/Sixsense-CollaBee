    <!-- 칸반 카드 총 개수 조회 (TaskVo 필드와 정확히 일치) -->
    <select id="selectListCountTask" parameterType="com.demo.proworks.task.vo.TaskVo" resultType="long">
    <!-- 업무(Task) 정보 목록의 카운트를 조회한다. -->
    
         SELECT    /* QueryID : com.demo.proworks.task.selectListCountTask */
             COUNT(*) totcnt  		                  
         FROM TASK
         WHERE  1=1    		
         <if test="projectUserId != null and projectUserId != ''"> AND PROJECT_USER_ID = #{projectUserId} </if>
         <if test="boardId != null and boardId != ''"> AND BOARD_ID = #{boardId} </if>
    </select>
    
    <!-- 보드별 카드 개수 조회 (TaskVo 필드 기반) -->
    <select id="selectCardCountByBoard" parameterType="com.demo.proworks.task.vo.TaskVo" resultType="map">
        <!-- 각 보드별 카드 개수를 조회한다. -->
        SELECT   /* QueryID : com.demo.proworks.task.selectCardCountByBoard */
            BOARD_ID as boardId,
            COUNT(*) as cardCount
        FROM TASK 
        WHERE 1=1
        <if test="projectUserId != null and projectUserId != ''"> AND PROJECT_USER_ID = #{projectUserId} </if>
        GROUP BY BOARD_ID
        ORDER BY BOARD_ID
    </select>

