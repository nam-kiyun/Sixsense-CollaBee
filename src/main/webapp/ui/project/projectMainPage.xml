				<xf:group class="header-actions">
					<!-- GitHub 연동 버튼 - 제일 왼쪽에 배치 -->
					<xf:trigger type="button" class="btn-github btn-github-main" id="btn_github" ev:onclick="scwin.github_onclick">
						<xf:label><![CDATA[🐙 GitHub]]></xf:label>
					</xf:trigger>

					<xf:trigger type="button" class="btn-github" id="btn_filter" ev:onclick="scwin.filter_onclick">
						<xf:label><![CDATA[🔽 Filter]]></xf:label>
					</xf:trigger>

					<xf:trigger type="button" class="btn-github" id="btn_sort" ev:onclick="scwin.sort_onclick">
						<xf:label><![CDATA[📊 Sort]]></xf:label>
					</xf:trigger>

