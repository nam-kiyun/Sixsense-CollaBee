					<!-- 새 카드 추가 버튼 -->
					<xf:trigger type="button" class="add-card-btn" ev:onclick="scwin.addCard_onclick('card_container_done')">
						<xf:label><![CDATA[+ Add card]]></xf:label>
					</xf:trigger>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
