<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/InsWebApp/css/user/verifyPasswordPage.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>COMPONENT</w2:type>
    	<w2:buildDate />
    	<w2:MSA />
    	<xf:model>
    		<w2:dataCollection baseNode="map">
    			<w2:dataMap baseNode="map" id="dma_Param">
    				<w2:keyInfo>
    					<w2:key dataType="text" name="아이디" id="userId"></w2:key>
    					<w2:key dataType="text" name="이름" id="userName"></w2:key>
    					<w2:key dataType="text" name="비밀번호" id="password"></w2:key>
    					<w2:key dataType="text" name="이미지 URL" id="profileImageUrl"></w2:key>
    					<w2:key dataType="text" name="상태" id="isActive"></w2:key>
    					<w2:key dataType="text" name="가입일" id="createdAt"></w2:key>
    					<w2:key dataType="text" name="로그인 실패 횟수" id="loginFailCount"></w2:key>
    					<w2:key dataType="text" name="로그인 실패 시간" id="lastFailTime"></w2:key>
    					<w2:key dataType="text" name="계정 잠금 여부" id="accountLocked"></w2:key>
    					<w2:key dataType="text" name="파일 데이터" id="fileData"></w2:key>
    				</w2:keyInfo>
    			</w2:dataMap>
    		</w2:dataCollection>
    		<w2:workflowCollection />
    		<xf:submission id="sbm_checkPassword" action="/InsWebApp/user/checkpassword.pwkjson" method="post" mediatype="application/json" ref='data:json,{"id":"dma_Param","key":"elData"}' target='' encoding="UTF-8"
    			instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.sbm_checkPassword_submitdone"
    			ev:submiterror="" abortTrigger="">
    		</xf:submission>
    	</xf:model>
    	<w2:layoutInfo />
    	<w2:publicInfo method="" />
    	<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    scwin.onresize();
    scwin.userId = $p.getParameter("userId");
    scwin.userName = $p.getParameter("userName");
};

scwin.onresize = function (e) {
    // resize 이벤트 정의
    window.onresize = function () {
        scwin.applyResponsiveWidth();
    };

    // 페이지 로딩 시에도 한 번 실행
    scwin.applyResponsiveWidth();
};


//반응형 width 값 조절
scwin.applyResponsiveWidth = function () {
    let width = window.innerWidth;

    if (width <= 670) {
        form_group.setStyle("width", "100%");
    } else if (width <= 1000) {
        form_group.setStyle("width", "60%");
    } else {
        form_group.setStyle("width", "40%");
    }
};

scwin.user_button_onclick = async function (e) {

    //비밀번호 서브미션
    let param = {
        userId: scwin.userId,
        password: password_input.getValue(),
    }

    dma_Param.setJSON(param);
    $c.sbm.execute(sbm_checkPassword);
    //await $c.win.alert("아이디 또는 비밀번호가 잘못 되었습니다.<br/> 아이디와 비밀번호를 정확히 입력해 주세요.");
};

scwin.sbm_checkPassword_submitdone = function (e) {
    const responseData = e.responseJSON;
    console.log(responseData);

    if(responseData.elData){
        let param = {
            "userId": responseData.elData.userId,
            "userName": responseData.elData.userName,
            "profileImageUrl": responseData.elData?.profileImageUrl || ""
        }
        let option = {
            "spa": true,
            "param": param
        }
        $p.url("/InsWebApp/ui/user/myPage.xml", option);
    }else{
        $c.win.alert("비밀번호가 올바르지 않습니다. <br/> 다시 시도해주세요.");
    }
};
]]></script>
    	<style type="text/css"><![CDATA[body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
}

.container-group {
    margin: 0;
    padding: 0;
}

/* 헤더 */
.header-group {
    height: 20%;
}

/* 메인 */
.main-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    height: 80%;
    overflow: hidden;
}

/* 전체 폼 */
.form-group {
    width: 40%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 40px;
    
}

/* 버튼 */
.user-button {
    width: 60%;
    height: 35px;
    border-radius: 6px;
    background-color: #FFB823;
    outline: none;
    border: none;
}

.user-button:hover {
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
}

/* title 부분*/
.title-text {
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 30px;
}

/* 비밀번호 input 부분 그룹 */
.password-group {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
}

.password-group .password-input {
    width: 50%;
    height: 40px;
}]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents container-group" id="" meta_snippetCategory="00_화면시작" meta_snippetKeyComponent="true"
    		meta_snippetName="0_01 페이지시작" style="">
    		<xf:group style="" id="" class="header-group">
    			<w2:pageFrame style="" id="" src="/InsWebApp/ui/cmmn/header.xml"></w2:pageFrame>
    		</xf:group>
    	</xf:group>
    	<xf:group style="" id="" class="main-group">
    		<xf:group style="" id="form_group" class="form-group">
    			<w2:textbox style="" id="" label="회원정보 수정" class="title-text"></w2:textbox>
    			<xf:group style="" id="" class="password-group">
    				<w2:textbox style="" id="" label="비밀번호" class=""></w2:textbox>
    				<xf:secret id="password_input" style="" class="password-input"></xf:secret>
    			</xf:group>
    			<xf:trigger style="" id="user_button" type="button" class="user-button" ev:onclick="scwin.user_button_onclick">
    				<xf:label><![CDATA[확인]]></xf:label>
    			</xf:trigger>
    		</xf:group>
    	</xf:group>
    </body>
</html>
