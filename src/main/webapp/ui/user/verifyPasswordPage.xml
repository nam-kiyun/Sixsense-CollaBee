    		<xf:group style="" id="" class="header-group">
    			<w2:pageFrame style="" id="" src="/InsWebApp/ui/cmmn/header.xml"></w2:pageFrame>
    		</xf:group>
    	</xf:group>
    	<xf:group style="" id="" class="main-group">
    		<xf:group style="" id="form_group" class="form-group">
    			<w2:textbox style="" id="" label="회원정보 수정" class="title-text"></w2:textbox>
    			<xf:group style="" id="" class="password-group">
    				<w2:textbox style="" id="" label="비밀번호" class=""></w2:textbox>
    				<xf:input style="" id="" class="password-input"></xf:input>
    			</xf:group>
    			<xf:trigger ev:onclick="scwin.trigger1_onclick" style="" id="trigger1" type="button" class="user-button">
    				<xf:label><![CDATA[확인]]></xf:label>
