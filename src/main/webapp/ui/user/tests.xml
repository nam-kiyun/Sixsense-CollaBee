		<w2:style><![CDATA[
            /* 여기에 이미지 버튼을 위한 CSS를 추가합니다 */
            #file_button {
                background-image: url(''); /* 여기에 사용할 이미지 파일 경로를 입력하세요 */
                background-repeat: no-repeat;
                background-position: center;
                background-size: contain; /* 또는 cover, 100% 100% 등 필요에 따라 조정 */
                border: none; /* 버튼 테두리 제거 */
                cursor: pointer; /* 마우스 오버 시 포인터 변경 */
                /* width와 height는 이미 트거에 설정되어 있으므로 필요 시 조정 */
            }

            #file_button .w2tb_label { /* 웹스퀘어 트리거의 레이블 텍스트를 숨기기 위한 클래스 */
                display: block; /* label이 span으로 렌더링될 경우를 대비하여 block으로 설정 */
                text-indent: -9999px; /* 텍스트를 화면 밖으로 밀어내어 숨김 */
                overflow: hidden; /* 넘치는 텍스트 숨김 */
                width: 100%;
                height: 100%;
            }
        ]]></w2:style>
