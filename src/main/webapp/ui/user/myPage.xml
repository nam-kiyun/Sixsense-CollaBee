    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    scwin.onresize();

    //전역변수
    scwin.file = "";
};

scwin.onresize = function (e) {
    // resize 이벤트 정의
    window.onresize = function () {
        scwin.applyResponsiveWidth();
    };

    // 페이지 로딩 시에도 한 번 실행
    scwin.applyResponsiveWidth();
};


//반응형 width 값 조절
scwin.applyResponsiveWidth = function () {
    let width = window.innerWidth;

    if (width <= 700) {
        form_group.setStyle("width", "100%");
    } else if (width <= 1000) {
        form_group.setStyle("width", "60%");
    } else {
        form_group.setStyle("width", "40%");
    }
};


scwin.profile_button_onclick = function (e) {
    $p.$("#fileInput_hidden").click();
    $p.$("#fileInput_hidden").on("change", scwin.fileInput_change);
};

scwin.profileIcon_button_onclick = function (e) {
    $p.$("#fileInput_hidden").click();
    $p.$("#fileInput_hidden").on("change", scwin.fileInput_change);
};

//파일 탐색기에서 이미지 선택했을 때 
scwin.fileInput_change = function (e) {
    const fileInput = $p.$("#fileInput_hidden").get(0);
    const file = fileInput.files[0];

    if (!file) return;
    scwin.file = file;
}

//회원정보 수정된거 저장하는 버튼
scwin.update_button_onclick = function (e) {
    const formData = new FormData();

    // 빈 값으로 필드 세팅
    formData.append("userId", "");
    formData.append("userName", "");
    formData.append("password", "");
    formData.append("profileImageUrl", "");
    formData.append("isActive", "");
    formData.append("createdAt", "");
    formData.append("loginFailCount", 0);
    formData.append("lastFailTime", "");
    formData.append("accountLocked", "");
    formData.append("fileData", scwin.file);

    $.ajax({
        url: "/InsWebApp/user/update.pwkjson",  // 반드시 .pwk!
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            console.log("✅ 성공:", res);
        },
        error: function (err) {
            console.error("❌ 실패:", err);
        }
    });

};

]]></script>
