    	<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function() {
	scwin.getTask(1, 7);
};

//task 정보 가져오기
scwin.getTask = function (taskId, projectId) {
    //  데이터 보내기
    const formData = new FormData();
    formData.append("projectId", projectId);

    // 서버로 전송
    $.ajax({
        url: `/InsWebApp/task/${taskId}.pwkjson`,
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: async function (res) {
            const data = res.taskUpdateVo;
            scwin.taskInfo = data;

            console.log(data);

            // projectUserVo 리스트를 세팅


            // //담당자(프로젝트 사용자 값 세팅)
            let userData = [];
            data.projectUserVo.forEach(user => {
                userData.push({ userId: user.userId, userName: user.userName });
            });
            dls_manager.setJSON(userData);

            // //담당자 존재하면 값 세팅
            if (data.managerVo && data.managerVo.length > 0) {
                let selectedUserIds = [];
                data.managerVo.forEach(manager => {
                    selectedUserIds.push(manager.userId);
                });

                manager_input.setValue(selectedUserIds);
            }

            data.priority ? priority_select.setValue(data.priority) : "";
            data.tags ? tags_input.setValue(data.tags) : "";
            data.startDate ? start_date.setValue(data.startDate) : "";
            data.endDate ? end_date.setValue(data.endDate) : "";
            data.userName ? userName_input.setValue(data.userName) : "";

            body_text.setValue(data.content);


            // const fileList = data.fileSrcVo;

            // // HTML 에디터의 기존 내용 가져오기
            // let html = contents_editor.getHTML();

            // // DOM 파싱을 위한 임시 컨테이너 생성
            // const container = document.createElement("div");
            // container.innerHTML = html;

            // // file-data 클래스를 가진 태그들을 순서대로 가져오기
            // const fileTags = container.querySelectorAll(".file-data");

            // // fileList 순서와 fileTags 순서가 일치한다고 가정하고 data-num 추가
            // fileList.forEach((item, index) => {
            //     item.num = ++scwin.filePageNum;

            //     const el = fileTags[fileTags.length - 1 - index];

            //     if (el) {
            //         el.setAttribute("data-num", item.num);
            //     }
            // });

            // contents_editor.setHTML(container.innerHTML);
            // scwin.previousHTML = contents_editor.getHTML();

            // dls_allFile.setJSON(data.fileSrcVo);
            // dls_file.setJSON(data.fileSrcVo);

        },
        error: async function (err) {
            await $c.win.alert("저장 실패! 다시 시도해주세요");
        }
    });
}]]></script>
