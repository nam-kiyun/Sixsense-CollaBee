    					<w2:key dataType="text" name="이미지 URL" id="profileImageUrl"></w2:key>
    					<w2:key dataType="text" name="상태" id="isActive"></w2:key>
    					<w2:key dataType="text" name="가입일" id="createdAt"></w2:key>
    					<w2:key dataType="text" name="로그인 실패 횟수" id="loginFailCount"></w2:key>
    					<w2:key dataType="text" name="로그인 실패 시간" id="lastFailTime"></w2:key>
    					<w2:key dataType="text" name="계정 잠금 여부" id="accountLocked"></w2:key>
    					<w2:key dataType="text" name="파일" id="fileData"></w2:key>
    				</w2:keyInfo>
    			</w2:dataMap>
    			<w2:dataMap baseNode="map" id="dma_userInfo">
    				<w2:keyInfo>
    					<w2:key dataType="text" name="사용자명" id="userName"></w2:key>
    					<w2:key dataType="text" name="사용자ID" id="userId"></w2:key>
    					<w2:key dataType="text" name="사용자 이미지" id="profileImageUrl"></w2:key>
    				</w2:keyInfo>
    			</w2:dataMap>
    			<w2:dataMap baseNode="map" id="dma_logout">
    				<w2:keyInfo>
    					<w2:key dataType="text" name="아이디" id="id"></w2:key>
    					<w2:key dataType="text" name="비밀번호" id="password"></w2:key>
