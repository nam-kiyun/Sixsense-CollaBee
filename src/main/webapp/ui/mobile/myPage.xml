<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/InsWebApp/css/mobile/taskPage.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>COMPONENT</w2:type>
    	<w2:buildDate />
    	<w2:MSA />
    	<xf:model>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" repeatNode="map" id="dls_manager" saveRemovedData="true">
    				<w2:columnInfo>
    					<w2:column dataType="text" name="사용자 아이디" id="userId"></w2:column>
    					<w2:column dataType="text" name="사용자 이름" id="userName"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection />
    	</xf:model>
    	<w2:layoutInfo />
    	<w2:publicInfo method="" />
    	<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function() {

};

scwin.profile_button_onclick = function (e) {
    $p.$("#fileInput_hidden").click();
    $p.$("#fileInput_hidden").on("change", scwin.fileInput_change);
};

scwin.profileIcon_button_onclick = function (e) {
    $p.$("#fileInput_hidden").click();
    $p.$("#fileInput_hidden").on("change", scwin.fileInput_change);
};

//파일 탐색기에서 이미지 선택했을 때 
scwin.fileInput_change = function (e) {
    const fileInput = $p.$("#fileInput_hidden").get(0);
    const file = fileInput.files[0];

    if (!file) return;
    scwin.file = file;

    const imageUrl = URL.createObjectURL(file);
    profile_button.setStyle("background-image", `url('${imageUrl}')`);
}]]></script>
    	<style type="text/css"><![CDATA[html,
body {
    margin: 0;
    padding: 0;
    height: 100%;
    /* 전체 높이 설정 */
}

.wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.header-group {
    height: 50px;
    background-color: black;
}

.main-group {
    flex: 1;
    overflow: auto;
    /* background-color: rgb(201, 148, 83); */
}

.footer-group {
    height: 50px;
    background-color: rgb(197, 226, 184);
}


.myPage-header {
    display: flex;
    width: 100%;
    height: 10%;
    align-items: center;
    padding: 0 20px;
    box-sizing: border-box;
    /* background-color: pink; */
}

.header-title {
    font-size: large;
    font-weight: bold;
}

.myPage-body {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 90%;
    padding: 50px;
    gap: 20px;
    box-sizing: border-box;
    align-items: center;
}

.input-form {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 30%;
    gap: 15px;
}

.dec-title {
    width: 70%;
    min-height: 16%;
    font-size: 23px;
    font-weight: bold;
    margin-bottom: 15px;
}

.image-group {
    position: relative;
    width: 200px;
    height: 200px;
}

.profile-button {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background-image: url('https://github.com/dorazi0423/test/blob/main/group1.png?raw=true');
    background-size: cover;
    background-position: center;
}

.profileIcon-button {
    position: absolute;
    bottom: -5px;
    right: -5px;
    transform: translate(-30%, -30%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-image: url(' /InsWebApp/images/camera.svg');
    background-size: 30px 30px;
    background-position: center;
    background-repeat: no-repeat;
    border: none;
    outline: none;
    background-color: #FFB823;
}

.dec-group {
    display: flex;
    min-height: 14%;
    gap: 15px;
}

.dec-name {
    width: 40%;
    font-weight: bold;
    font-size: 16px;
}


.contents-body {
    display: flex;
    width: 100%;
    min-height: 55%;
    padding: 30px;
    box-sizing: border-box;
    gap: 10px;
    background-color: rgb(68, 156, 156);
}

.body-text {
    width: 100%;
    min-height: 55%;
    padding: 30px;
    box-sizing: border-box;
    border: 1px solid black;
    border-radius: 15px;
}

.save-button {
    width: 100%;
    height: 35px;
    border-radius: 6px;
    background-color: #FFB823;
    outline: none;
    border: none;
}]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group style="" id="" class="wrapper ">
    		<w2:pageFrame style="" id="" class="header-group"></w2:pageFrame>
    		<xf:group style="" id="" class="main-group">
    			<xf:group style="" id="" class="myPage-header">
    				<w2:textbox id="" label="마이페이지" style="" class="header-title"></w2:textbox>
    			</xf:group>
    			<xf:group style="" id="" class="myPage-body">
    				<xf:group style="" id="" class="image-group">
    					<xf:trigger ev:onclick="scwin.profile_button_onclick" style="" id="profile_button" type="button"
    						class="profile-button">
    						<xf:label></xf:label>
    					</xf:trigger>
    					<xf:trigger ev:onclick="scwin.profileIcon_button_onclick" style="" id="profileIcon_button" type="button"
    						class="profileIcon-button">
    						<xf:label></xf:label>
    					</xf:trigger>
    					<input style="display:none;" id="fileInput_hidden" type="file" class="" onchange="scwin.fileInput_change"></input>
    				</xf:group>
    				<xf:group style="" id="" class="input-form">
    					<xf:group style="" id="" class="dec-group">
    						<w2:textbox style="" id="" label="이름" class="dec-name"></w2:textbox>
    						<xf:input id="" style="width: 144px;height: 21px;"></xf:input>
    					</xf:group>
    					<xf:group style="" id="" class="dec-group">
    						<w2:textbox style="" id="" label="아이디" class="dec-name"></w2:textbox>
    						<w2:textbox style="width:134px;height:23px;" id="userName_input" label="dddd"></w2:textbox>
    					</xf:group>
    					<xf:group style="" id="" class="dec-group">
    						<w2:textbox style="" id="" label="비밀번호" class="dec-name"></w2:textbox>
    						<xf:secret id="" style="width: 144px;height: 21px;"></xf:secret>
    					</xf:group>
    					<xf:group style="" id="" class="dec-group">
    						<w2:textbox style="" id="" label="비밀번호 확인" class="dec-name"></w2:textbox>
    						<xf:secret id="" style="width: 144px;height: 21px;"></xf:secret>
    					</xf:group>
    				</xf:group>
    				<xf:trigger type="button" style="" id="" class="save-button">
    					<xf:label><![CDATA[수정]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    		<w2:pageFrame style="" id="" class="footer-group" src="/InsWebApp/ui/mobile/cmmn/footer.xml"></w2:pageFrame>
    	</xf:group>
    </body>
</html>
