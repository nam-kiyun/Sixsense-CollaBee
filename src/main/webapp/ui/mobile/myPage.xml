    			</w2:dataMap>
    		</w2:dataCollection>
    		<w2:workflowCollection />
    		<xf:submission id="sbm_getUserInfo" action="/InsWebApp/user/sessionInfo.pwkjson" method="post" mediatype="application/json"
    			ref="" target='data:json,{"id":"dma_userInfo","key":"userInfo"}' encoding="UTF-8" instance="" replace="" errorHandler=""
    			customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.sbm_getUserInfo_submitdone"
    			ev:submiterror="scwin.sbm_getUserInfo_submiterror" abortTrigger="">
    		</xf:submission>
    		<xf:submission id="sbm_logout" action="/InsWebApp/user/logout.pwkjson" method="post" mediatype="application/json"
    			ref='data:json,{"id":"dma_logout","key":"elData"}' target="" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler=""
    			mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.sbm_logout_submitdone" ev:submiterror="" abortTrigger="">
    		</xf:submission>
    	</xf:model>
    	<w2:layoutInfo />
    	<w2:publicInfo method="" />
    	<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    $p.executeSubmission("sbm_getUserInfo");

    //전역변수
    scwin.file = "";
}


scwin.profile_button_onclick = function (e) {
    $p.$("#fileInput_hidden").click();
    $p.$("#fileInput_hidden").on("change", scwin.fileInput_change);
};

scwin.profileIcon_button_onclick = function (e) {
    $p.$("#fileInput_hidden").click();
    $p.$("#fileInput_hidden").on("change", scwin.fileInput_change);
};

//파일 탐색기에서 이미지 선택했을 때 
scwin.fileInput_change = function (e) {
    const fileInput = $p.$("#fileInput_hidden").get(0);
    const file = fileInput.files[0];

    if (!file) return;
    scwin.file = file;

    const imageUrl = URL.createObjectURL(file);
    profile_button.setStyle("background-image", `url('${imageUrl}')`);
}


//회원정보 수정된거 저장하는 버튼
scwin.save_button_onclick = function (e) {
    let password = password_input.getValue();
    let passwordCheck = passwordCheck_input.getValue();

    let isValid = true;
    let pwRegex = /^(?=.*[A-Za-z])(?=.*\d)(?=.*[!@#$%^&*()_+={}\[\]:;"'<>,.?/-]).{8,}$/;

    if (password && !pwRegex.test(password)) {
        $c.win.alert("비밀번호는 8자 이상이며 영문자·숫자·특수문자를 포함해야 합니다");
        password_error_text.setValue("*비밀번호는 8자 이상이며 영문자·숫자·특수문자를 포함해야 합니다.");
        isValid = false;
    }

    // 비밀번호 일치 검사
    if (password && passwordCheck && password !== passwordCheck) {
        $c.win.alert("비밀번호가 일치하지 않습니다");
        //passwordCheck_error_text.setValue("*비밀번호가 일치하지 않습니다.");
        isValid = false;
    }

    if (!isValid) return;

    //  데이터 보내기
    const formData = new FormData();

    // 빈 값으로 필드 세팅
    formData.append("userId", email_input.getValue());
    formData.append("userName", userName_input.getValue());
    formData.append("password", password_input.getValue());
    formData.append("fileData", scwin.file);

    $.ajax({
        url: "/InsWebApp/user/update.pwkjson",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: async function (res) {
            await $c.win.alert("회원정보가 수정되었습니다");
        },
        error: async function (err) {
            await $c.win.alert("회원정보 수정을 실패했습니다");
        }
    });
};

scwin.sbm_getUserInfo_submitdone = function (e) {
    const responseData = e.responseJSON.userVo;
    console.log(responseData);

    userName_input.setValue(responseData.userName);
    email_input.setValue(responseData.userId);

    if (responseData?.profileImageUrl) {
        profile_button.setStyle("background-image", `url('${responseData.profileImageUrl}')`);
    }

    dma_logout.set("id", responseData.userId);
    
    side_frame.getWindow().dm_sideMenu.set("userName", responseData.userId);
    side_frame.getWindow().scwin.loadUserProjects();
    //header.getWindow().output_userName.setValue(responseData.userName);
    //header.getWindow().img_userIcon.setSrc(responseData.profileImageUrl);
};

scwin.sbm_getUserInfo_submiterror = function (e) {
    console.log(e);
};

scwin.logout_button_onclick = function (e) {
    $p.executeSubmission("sbm_logout");
};

scwin.sbm_logout_submitdone = function (e) {
    $p.url("/InsWebApp/ui/mobile/auth/loginPage.xml");
};
]]></script>
