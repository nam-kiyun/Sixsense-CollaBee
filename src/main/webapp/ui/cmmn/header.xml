<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="공통 헤더">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        
        <!-- CSS 파일 링크 -->
        <link rel="stylesheet" type="text/css" href="/css/cmmn/header.css"/>
        
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataMap baseNode="map" id="dm_header">
        			<w2:keyInfo>
        				<w2:key id="userName" name="사용자명" dataType="text" />
        			</w2:keyInfo>
        			<w2:data use="true">
        				<userName>게스트</userName>
        			</w2:data>
        		</w2:dataMap>
        		<w2:dataMap baseNode="map" id="dma_logout">
        			<w2:keyInfo>
        				<w2:key dataType="text" name="아이디" id="id"></w2:key>
        				<w2:key dataType="text" name="비밀번호" id="password"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        	</w2:dataCollection>
        	<w2:workflowCollection />
        	<xf:submission id="sbm_logout" action="/InsWebApp/user/logout.pwkjson" method="post" mediatype="application/json" ref='data:json,{"id":"dma_logout","key":"elData"}' target="" encoding="UTF-8"
        		instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.dma_logout_submitdone"
        		ev:submiterror="scwin.dma_logout_submiterror" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="sbm_session" action="/InsWebApp/user/sessionInfo.pwkjson" method="post" mediatype="application/json" ref="" target="" encoding="UTF-8"
        		instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.dma_session_submitdone"
        		ev:submiterror="scwin.dma_session_submiterror" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    // 헤더 초기화
    $p.executeSubmission("sbm_session");
};

scwin.btn_logout_onclick = function (e) {
    $p.executeSubmission("sbm_logout");
};

scwin.grp_userInfo_onclick = function (e) {
    $p.url("/InsWebApp/ui/user/myPage.xml");
};

scwin.grp_logo_onclick = function (e) {
    $p.url("/InsWebApp/ui/mainPage.xml");
};

scwin.dma_session_submitdone = function (e) {
    const responseData = e.responseJSON.userVo;
    dma_logout.set("id", responseData.userId);
};

scwin.dma_logout_submitdone = function (e) {
    $p.url("/InsWebApp/ui/landingPage.xml");
};

scwin.dma_logout_submiterror = function (e) {
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <!-- 헤더 전체 컨테이너 -->
        <xf:group 
            style="background-color:#4A3F35;display: flex;justify-content: space-between;align-items: center;height:100px;padding: 0 24px;position: relative;"
            id="grp_header">
            
            <!-- 로고 영역 -->
            <xf:group style="display:flex;align-items:center;gap:16px;cursor: pointer" id="grp_logo" ev:onclick="scwin.grp_logo_onclick">
                <xf:image src="/InsWebApp/images/collabee.png" style="width:65px;height:65px;" id="img_logo"/>
                <xf:output style="color:#ffb823;font-weight:bold;font-size:32px;font-family:Koulen,sans-serif;" id="output_logo">
                    <xf:label><![CDATA[COLLABEE]]></xf:label>
                </xf:output>
            </xf:group>
            
            <!-- 사용자 영역 -->
            <xf:group style="display: flex;gap: 16px;align-items: center;" id="grp_userArea">
                
                <!-- 사용자 정보 -->
                <xf:group style="display:flex;align-items:center;cursor: pointer;gap:4px;" id="grp_userInfo" ev:onclick="scwin.grp_userInfo_onclick">
                    <xf:image src="/InsWebApp/assets/images/account_circle.svg" style="width:45px;height:46px; border-radius: 50%;" id="img_userIcon"/>
                    <xf:output style="color:#ffffff;font-size:20px;font-family:Inter,sans-serif;" 
                               ref="dm_header.userName" id="output_userName"/>
                    <xf:output style="color:#ffffff;font-size:20px;font-family:Inter,sans-serif;" id="output_nim">
                        <xf:label><![CDATA[ 님]]></xf:label>
                    </xf:output>
                </xf:group>
                
                <!-- 로그아웃 버튼 -->
                <xf:trigger 
                    style="width:146px;height:48px;background-color:#ffb823;border:1px solid rgba(0,0,0,0.2);border-radius:16px;color:#000000;font-size:24px;font-family:Inter,sans-serif;cursor:pointer;" 
                    id="btn_logout" 
                    type="button" 
                    ev:onclick="scwin.btn_logout_onclick">
                    <xf:label><![CDATA[로그아웃]]></xf:label>
                </xf:trigger>
                
            </xf:group>
            
        </xf:group>
    </body>
</html>