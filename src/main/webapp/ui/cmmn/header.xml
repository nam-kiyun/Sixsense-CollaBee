<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="공통 헤더">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        
        <!-- CSS 파일 링크 -->
        <link rel="stylesheet" type="text/css" href="/css/cmmn/header.css"/>
        
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dm_header">
                    <w2:keyInfo>
                        <w2:key id="userName" name="사용자명" dataType="text"/>
                    </w2:keyInfo>
                    <w2:data use="true">
                        <userName>게스트</userName>
                    </w2:data>
                </w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    // 헤더 초기화
};

scwin.btn_logout_onclick = function(e) {
    if (confirm("로그아웃 하시겠습니까?")) {
        alert("로그아웃 되었습니다.");
        // 실제 로그아웃 처리 로직 추가
        // location.href = "/logout";
    }
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <!-- 헤더 전체 컨테이너 -->
        <xf:group 
            style="background-color:#4A3F35;display: flex;justify-content: space-between;align-items: center;height:100px;padding: 0 24px;position: relative;"
            id="grp_header">
            
            <!-- 로고 영역 -->
            <xf:group style="display:flex;align-items:center;gap:16px;" id="grp_logo">
                <xf:image src="/InsWebApp/images/collabee.png" style="width:65px;height:65px;" id="img_logo"/>
                <xf:output style="color:#ffb823;font-weight:bold;font-size:32px;font-family:Koulen,sans-serif;" id="output_logo">
                    <xf:label><![CDATA[COLLABEE]]></xf:label>
                </xf:output>
            </xf:group>
            
            <!-- 사용자 영역 -->
            <xf:group style="display: flex;gap: 16px;align-items: center;" id="grp_userArea">
                
                <!-- 사용자 정보 -->
                <xf:group style="display:flex;align-items:center;gap:4px;" id="grp_userInfo">
                    <xf:image src="/InsWebApp/assets/images/account_circle.svg" style="width:45px;height:46px;" id="img_userIcon"/>
                    <xf:output style="color:#ffffff;font-size:20px;font-family:Inter,sans-serif;" 
                               ref="dm_header.userName" id="output_userName"/>
                    <xf:output style="color:#ffffff;font-size:20px;font-family:Inter,sans-serif;" id="output_nim">
                        <xf:label><![CDATA[ 님]]></xf:label>
                    </xf:output>
                </xf:group>
                
                <!-- 로그아웃 버튼 -->
                <xf:trigger 
                    style="width:146px;height:48px;background-color:#ffb823;border:1px solid rgba(0,0,0,0.2);border-radius:16px;color:#000000;font-size:24px;font-family:Inter,sans-serif;cursor:pointer;" 
                    id="btn_logout" 
                    type="button" 
                    ev:onclick="scwin.btn_logout_onclick">
                    <xf:label><![CDATA[로그아웃]]></xf:label>
                </xf:trigger>
                
            </xf:group>
            
        </xf:group>
    </body>
</html>