<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="메인 콘텐츠">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dm_userInfo">
                    <w2:keyInfo>
                        <w2:key id="userName" name="사용자명" dataType="text"/>
                        <w2:key id="userId" name="사용자ID" dataType="text"/>
                    </w2:keyInfo>
                    <w2:data use="true">
                        <userName>식스센스</userName>
                        <userId>user01</userId>
                    </w2:data>
                </w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    // 메인 콘텐츠 초기화
    scwin.loadUserInfo();
};

// 사용자 정보 로드
scwin.loadUserInfo = function() {
    try {
        // 부모 창에서 사용자 정보 가져오기
        if (parent && parent.dm_userInfo) {
            const userName = parent.dm_userInfo.get("userName") || "식스센스";
            dm_userInfo.set("userName", userName);
            scwin.updateWelcomeMessage();
        } else {
            // 기본값 사용
            dm_userInfo.set("userName", "식스센스");
            scwin.updateWelcomeMessage();
        }
    } catch(e) {
        console.log("사용자 정보 로드 오류:", e);
        dm_userInfo.set("userName", "식스센스");
        scwin.updateWelcomeMessage();
    }
};

// 환영 메시지 업데이트
scwin.updateWelcomeMessage = function() {
    try {
        var userName = dm_userInfo.get("userName") || "식스센스";
        var welcomeText = userName + "님 안녕하세요";
        output_welcomeText.setValue(welcomeText);
        console.log("환영 메시지 업데이트:", welcomeText);
    } catch(e) {
        console.log("환영 메시지 업데이트 오류:", e);
    }
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <!-- 메인 콘텐츠 -->
        <xf:group style="width:100%;height:100%;background-color:#fff4d6;padding:40px;" id="grp_mainContent">
            
