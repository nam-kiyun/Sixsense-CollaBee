                                    <xf:output style="color:white;font-size:10px;font-weight:600;" id="output_avatar3">
                                        <xf:label><![CDATA[AK]]></xf:label>
                                    </xf:output>
                                </xf:group>
                                <xf:group style="width:26px;height:26px;background-color:#EC4899;border-radius:50%;display:flex;align-items:center;justify-content:center;" id="grp_avatar4">
                                    <xf:output style="color:white;font-size:10px;font-weight:600;" id="output_avatar4">
                                        <xf:label><![CDATA[LW]]></xf:label>
