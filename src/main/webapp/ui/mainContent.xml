                            <xf:image src="/InsWebApp/assets/images/timer.svg" style="width:18px;height:18px;" id="img_timer1"/>
                            <xf:output style="font-size:14px;color:rgba(0,0,0,0.6);font-family:Inter,sans-serif;" id="output_lastUpdate1">
