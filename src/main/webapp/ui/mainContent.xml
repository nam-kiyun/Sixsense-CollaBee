            <xf:group style="text-align:center;margin-bottom:60px;" id="grp_welcomeMessage">
                <xf:output style="font-size:60px;font-weight:bold;color:#000000;font-family:'Andada Pro',serif;" id="output_welcomeText">
                    <xf:label><![CDATA[식스센스님 안녕하세요]]></xf:label>
                </xf:output>
            </xf:group>
            
            <!-- 진행중인 프로젝트 섹션 -->
            <xf:group style="display:flex;align-items:center;margin-bottom:30px;" id="grp_projectsTitle">
