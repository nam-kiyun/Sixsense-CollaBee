                            <xf:group style="display:flex;gap:3px;align-items:center;" id="grp_teamAvatars">
                                <xf:group style="width:26px;height:26px;background-color:#3B82F6;border-radius:50%;display:flex;align-items:center;justify-content:center;" id="grp_avatar1">
