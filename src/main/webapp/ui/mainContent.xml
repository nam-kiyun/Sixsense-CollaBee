                    </xf:group>
                    
                    <!-- 하단 영역 (팀정보 + 구분선 + 업데이트정보) -->
                    <xf:group style="display:flex;flex-direction:column;gap:15px;" id="grp_project2Bottom">
                        <!-- 팀 정보 -->
                        <xf:group id="grp_teamInfo">
