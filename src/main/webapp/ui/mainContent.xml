                                    <xf:output style="color:white;font-size:10px;font-weight:600;" id="output_avatar1_1">
                                        <xf:label><![CDATA[EM]]></xf:label>
                                    </xf:output>
                                </xf:group>
                                <xf:group style="width:26px;height:26px;background-color:#10B981;border-radius:50%;display:flex;align-items:center;justify-content:center;" id="grp_avatar1_2">
