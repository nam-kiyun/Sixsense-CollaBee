                        <!-- 구분선 -->
                        <xf:group style="width:100%;height:1px;background-color:rgba(0,0,0,0.2);" id="grp_divider2"/>
                        
                        <!-- 타이머와 업데이트 정보 -->
                        <xf:group style="display:flex;align-items:center;gap:8px;" id="grp_updateInfo2">
                            <xf:image src="/InsWebApp/assets/images/timer.svg" style="width:18px;height:18px;" id="img_timer2"/>
                            <xf:output style="font-size:14px;color:rgba(0,0,0,0.6);font-family:Inter,sans-serif;" id="output_lastUpdate2">
