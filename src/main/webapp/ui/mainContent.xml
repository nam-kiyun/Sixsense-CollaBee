                                <xf:group style="width:26px;height:26px;background-color:#6B7280;border-radius:50%;display:flex;align-items:center;justify-content:center;" id="grp_avatar6">
                                    <xf:output style="color:white;font-size:10px;font-weight:600;" id="output_avatar6">
                                        <xf:label><![CDATA[+7]]></xf:label>
                                    </xf:output>
                                </xf:group>
                            </xf:group>
